#!/usr/bin/env bash
# Install AI tooling CLIs (Claude Code, Codex, Antigravity, Copilot) at chezmoi apply time.
# On macOS Codex comes from the Homebrew cask (Brewfile.tmpl); npm is Linux-only.
# Sentinel-gated: re-runs do nothing once `~/.local/state/ai-tools-installed` exists.
# Bump versions below and run `dotfiles update ai` (clears the sentinel) to upgrade.

set -euo pipefail
{{ includeTemplate "ui.sh" . }}

SENTINEL="$HOME/.local/state/ai-tools-installed"
mkdir -p "$(dirname "$SENTINEL")"

# Node comes from fnm. npm globals live in fnm's default Node: on PATH in every
# shell through `fnm env`, and the same place `npm -g` and brew bundle's npm
# entries use. (fnm comes from the Brewfile/apt; without this, npm is not on
# PATH in the non-interactive chezmoi-apply context.)
if command -v fnm >/dev/null 2>&1; then
    eval "$(fnm env --shell bash --corepack-enabled 2>/dev/null)" || true
    fnm use default >/dev/null 2>&1 || true
fi

# One-time migration: npm globals used to target ~/.local/npm, which was never
# on PATH, so anything there was unreachable. Move what is still wanted into
# fnm's default Node, then remove the directory. Skipped: Codex (Homebrew cask
# on macOS) and the legacy Gemini CLI (replaced by Antigravity, agy).
legacy_npm="$HOME/.local/npm"
if [[ -d "$legacy_npm/lib/node_modules" ]] && command -v npm >/dev/null 2>&1; then
    migrated=1
    for dir in "$legacy_npm"/lib/node_modules/* "$legacy_npm"/lib/node_modules/@*/*; do
        [[ -f "$dir/package.json" ]] || continue
        pkg="${dir#"$legacy_npm"/lib/node_modules/}"
        case "$pkg" in
            @openai/codex | @google/gemini-cli) continue ;;
        esac
        if npm ls -g "$pkg" >/dev/null 2>&1; then
            continue
        fi
        ui_run "moved $pkg from ~/.local/npm to fnm's default Node" npm install -g "$pkg" || migrated=0
    done
    if [[ "$migrated" -eq 1 ]]; then
        rm -rf "$legacy_npm"
        ui_ok "removed ~/.local/npm (npm globals live in fnm's default Node)"
    else
        ui_hint "kept ~/.local/npm until the failed packages above install"
    fi
fi

{{- if .is_macos }}

# One-time migration: Codex moved from npm to the Homebrew cask. npm copies in
# fnm's per-Node globals shadow the cask on PATH (and vanish on a Node switch),
# and the ~/.local/npm copy lost its vendor binary. Remove them once the cask
# is in place; runs before the sentinel check so existing machines migrate.
if command -v brew >/dev/null 2>&1 && brew list --cask codex >/dev/null 2>&1; then
    for prefix in "$HOME/.local/npm" "${FNM_DIR:-$HOME/.local/share/fnm}"/node-versions/*/installation; do
        if [[ -d "$prefix/lib/node_modules/@openai/codex" ]]; then
            rm -rf "$prefix/lib/node_modules/@openai/codex"
            rm -f "$prefix/bin/codex"
            ui_ok "removed npm Codex from ${prefix/#$HOME/~} (brew cask provides it now)"
        fi
    done
fi
{{- end }}

if [[ -f "$SENTINEL" ]]; then
    exit 0
fi

ui_section "AI CLIs"
failed=0

# npm packages. Codex is unpinned: its config (.chezmoitemplates/codex-config.toml)
# tracks current releases, and an old pin failed to parse it on fresh machines.
NPM_PACKAGES=(
{{- if not .is_macos }}
    "@openai/codex"
{{- end }}
    "@github/copilot@1.0.73"
)

# First run: no default Node yet, so install the LTS and make it the default.
if command -v fnm >/dev/null 2>&1 && ! fnm list 2>/dev/null | grep -q default; then
    ui_run "installed Node LTS via fnm" sh -c 'fnm install --lts && fnm default lts-latest' || failed=1
    fnm use default >/dev/null 2>&1 || true
fi

if command -v claude >/dev/null 2>&1; then
    ui_skip "claude already installed"
else
    ui_run "installed Claude Code" bash -c 'curl -fsSL https://claude.ai/install.sh | bash' || failed=1
fi

# Antigravity CLI (agy) replaces legacy Gemini CLI. Self-updates in the
# background, so no version pin. Installs to ~/.local/bin/agy.
if command -v agy >/dev/null 2>&1 || [[ -x "$HOME/.local/bin/agy" ]]; then
    ui_skip "agy already installed"
elif ui_run "installed Antigravity CLI" bash -c 'curl -fsSL https://antigravity.google/cli/install.sh | bash'; then
    # The installer appends PATH exports to ~/.zshrc/~/.zprofile/~/.profile;
    # redundant (zshenv already adds ~/.local/bin) and clobbered by chezmoi apply.
    for profile in "$HOME/.zshrc" "$HOME/.zprofile" "$HOME/.profile"; do
        [[ -f "$profile" ]] || continue
        perl -i -0pe 's/\n*# Added by Antigravity CLI installer\nexport PATH="[^"]*\.local\/bin:\$PATH"\n?//g' "$profile" 2>/dev/null || true
    done
else
    failed=1
fi

if command -v npm >/dev/null 2>&1; then
    for pkg in "${NPM_PACKAGES[@]}"; do
        name="${pkg%@*}"
        [[ -n "$name" ]] || name="$pkg"  # unpinned scoped name: "@scope/pkg" has no version suffix
        if npm list -g "$name" >/dev/null 2>&1; then
            ui_skip "$name already installed"
        else
            ui_run "installed $pkg" npm install -g "$pkg" || failed=1
        fi
    done
else
    ui_warn "npm not on PATH; skipped ${NPM_PACKAGES[*]}"
    ui_hint "open a new shell so fnm provides Node, then: dotfiles update ai"
    failed=1
fi

# Only a clean run writes the sentinel, so failures retry on the next apply.
if [[ "$failed" -eq 0 ]]; then
    date -Iseconds > "$SENTINEL"
else
    ui_hint "failed installs retry on the next chezmoi apply"
fi
