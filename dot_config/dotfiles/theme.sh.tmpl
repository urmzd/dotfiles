# Generated by chezmoi from the machine's theme (see `dotfiles theme`); edits
# here are overwritten. .chezmoitemplates/ui.sh sources this at run time, so
# switching themes does not change (and re-run) every apply script.
{{- $ui := (includeTemplate "theme" . | fromJson).ui }}
_ui_t_preset={{ $ui.preset | default "default" | squote }}
{{- range $role := list "section" "step" "ok" "skip" "warn" "fail" }}
_ui_t_s_{{ $role }}={{ (get $ui $role).symbol | default "" | squote }}
{{- end }}
{{- range $role := list "section" "step" "ok" "skip" "warn" "fail" "dim" }}
_ui_t_c_{{ $role }}={{ (get $ui $role).color | default "" | squote }}
{{- end }}
