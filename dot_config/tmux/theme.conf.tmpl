# Generated by chezmoi from the machine's theme (see `dotfiles theme`); edits
# here are overwritten. Sourced by tmux.conf before catppuccin loads.
{{- $tmux := (includeTemplate "theme" . | fromJson).tmux }}
set -g @catppuccin_flavour {{ $tmux.flavour | squote }}

# catppuccin sets each @thm_* color only when unset (set -o), so clear them
# first (a previous theme's values would otherwise stick until the server
# restarts), then set this theme's overrides, which catppuccin then keeps.
{{- range list "bg" "fg" "rosewater" "flamingo" "pink" "mauve" "red" "maroon" "peach" "yellow" "green" "teal" "sky" "sapphire" "blue" "lavender" "subtext_1" "subtext_0" "overlay_2" "overlay_1" "overlay_0" "surface_2" "surface_1" "surface_0" "mantle" "crust" }}
set -gu @thm_{{ . }}
{{- end }}
{{- range $name, $color := $tmux.colors }}
set -g @thm_{{ $name }} {{ $color | quote }}
{{- end }}
