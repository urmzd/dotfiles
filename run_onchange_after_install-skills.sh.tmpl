#!/usr/bin/env bash
{{ includeTemplate "bash-modern.sh" . }}
# Install agentspec, register the dotfiles skills and agents, then add the
# agentspec sources of the selected skill packs (catalog.toml `skills`).
# Re-runs when that list changes; agentspec skips what it already has.
set -euo pipefail
{{ includeTemplate "ui.sh" . }}
ui_section "Agent skills"

if ! command -v agentspec &>/dev/null; then
    if ! ui_run "installed agentspec" fetch_and_run https://raw.githubusercontent.com/urmzd/agentspec/main/install.sh sh; then
        ui_hint "skills sync skipped; rerun chezmoi apply once the network is back"
        exit 0
    fi
fi

# Local skills and agents first (deployed by chezmoi; see
# run_after_sync-agent-resources for why not the source), then each selected
# pack's sources. A failed source is reported and skipped, not fatal.
SOURCES=(
    "$HOME/.agents"
{{- range (includeTemplate "skills" . | fromJson).sources }}
    {{ . | quote }}
{{- end }}
)
for src in ${SOURCES[@]+"${SOURCES[@]}"}; do
    label="$src"
    [[ "$src" == /* ]] && label="dotfiles skills and agents"
    ui_run "added $label" agentspec manage add "$src" --all-tools || true
done

ui_run "linked into every installed AI tool" agentspec sync --fast || true
{{- if not (includeTemplate "skills" . | fromJson).packs }}
ui_hint "more skill packs (scaffolding, review, frameworks): dotfiles package"
{{- end }}
