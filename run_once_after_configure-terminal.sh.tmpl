#!/usr/bin/env bash
# Configure macOS Terminal.app font
{{- if .is_macos }}
{{ includeTemplate "ui.sh" . }}
ui_section "Terminal.app"

if osascript -e 'tell application "Terminal" to set font name of default settings to "MonaspiceNe Nerd Font"' >/dev/null 2>&1 \
    && osascript -e 'tell application "Terminal" to set font size of default settings to 13' >/dev/null 2>&1; then
    ui_ok "font set: MonaspiceNe Nerd Font 13pt"
else
    ui_warn "could not set the Terminal.app font (AppleScript error)"
    ui_hint "set it by hand: Terminal > Settings > Profiles > Text"
fi
{{- end }}
