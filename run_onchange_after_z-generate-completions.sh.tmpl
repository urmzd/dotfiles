#!/usr/bin/env bash
# Chezmoi run_onchange - Pre-generate zsh completions at apply time
# Triggered by: {{ include "dot_zshrc.tmpl" | sha256sum }}
# Triggered by: {{ include "Brewfile.tmpl" | sha256sum }}
# Triggered by: {{ include "run_onchange_after_install-cloud-clis.sh.tmpl" | sha256sum }}
#
# Produces two artifacts, split by WHEN each can safely run:
#
#   ~/.zsh/completions/       fpath directory of #compdef files. Autoloaded
#                             lazily by zsh on first TAB, so it costs nothing
#                             at startup. Prepended to fpath BEFORE compinit.
#   ~/.zsh/brew-fpath.zsh     fpath entries only, sourced BEFORE compinit.
#   ~/.zsh/completions-post.zsh  snippets that call compdef / bashcompinit /
#                             complete. Those only exist AFTER compinit, so
#                             this file is sourced once oh-my-zsh has run it.
#
# The split is what lets ~/.zshrc get away with a single compinit. Sourcing
# gcloud's completion.zsh.inc from brew-fpath.zsh (i.e. pre-compinit) used to
# trigger a second, premature compinit of its own, and _aws / _npm sat in fpath
# without a leading #compdef tag, so compinit never bound them to a command and
# neither completion worked at all.

set -euo pipefail

COMP_DIR="$HOME/.zsh/completions"
FPATH_FILE="$HOME/.zsh/brew-fpath.zsh"
POST_FILE="$HOME/.zsh/completions-post.zsh"

mkdir -p "$COMP_DIR"
mkdir -p "$(dirname "$FPATH_FILE")"

# Truncate unconditionally so reruns don't accumulate.
: > "$FPATH_FILE"
: > "$POST_FILE"

{
    echo "# Generated by chezmoi apply. Sourced AFTER compinit."
    echo "# Everything here needs compdef/bashcompinit, which compinit defines."
} >> "$POST_FILE"

echo "Generating zsh completions..."

# ============================================================================
# 1. Discover Homebrew site-functions on macOS.
#    Linux distros drop completions into /usr/share/zsh/{site-functions,
#    vendor-completions} which zsh already has in fpath by default.
# ============================================================================
BREW_SITE=""
if command -v brew >/dev/null 2>&1; then
    brew_prefix="$(brew --prefix 2>/dev/null)"
    if [[ -d "${brew_prefix}/share/zsh/site-functions" ]]; then
        BREW_SITE="${brew_prefix}/share/zsh/site-functions"
        echo "fpath=(\"${BREW_SITE}\" \$fpath)" >> "$FPATH_FILE"
        echo "  Found brew site-functions: ${BREW_SITE}"
    fi
fi

# ============================================================================
# 2. Google Cloud SDK completion (installed to ~/.local/share/google-cloud-sdk)
#    Goes in POST_FILE: the script calls bashcompinit and, if compdef is still
#    undefined, runs a compinit of its own. Sourcing it pre-compinit is what
#    used to cost a whole extra compinit pass per shell.
# ============================================================================
GCLOUD_COMP=""
for candidate in \
    "$HOME/.local/share/google-cloud-sdk/completion.zsh.inc" \
    "/opt/homebrew/share/google-cloud-sdk/completion.zsh.inc" \
    "/usr/share/google-cloud-sdk/completion.zsh.inc" \
    "/snap/google-cloud-sdk/current/completion.zsh.inc"; do
    [[ -f "$candidate" ]] && GCLOUD_COMP="$candidate" && break
done

if [[ -n "${GCLOUD_COMP:-}" ]]; then
    {
        echo
        echo "# Google Cloud SDK completions"
        echo "source \"$GCLOUD_COMP\""
    } >> "$POST_FILE"
    echo "  Found gcloud completion: $GCLOUD_COMP"
fi

# ============================================================================
# 3. Generate completions for tools with no site-functions of their own
# ============================================================================

# Skip anything Homebrew already ships. Its copy is version-matched to the
# installed formula and updates with it; a generated snapshot only goes stale
# and, sitting earlier in fpath, would shadow the good one.
generate_completion() {
    local tool="$1"
    local cmd="$2"
    local target="$COMP_DIR/_$tool"

    command -v "$tool" >/dev/null 2>&1 || return 0

    if [[ -n "$BREW_SITE" && -f "$BREW_SITE/_$tool" ]]; then
        rm -f "$target"  # drop a snapshot left by an earlier run
        echo "  Skipped: _$tool (Homebrew ships it)"
        return 0
    fi

    if eval "$cmd" > "$target" 2>/dev/null; then
        echo "  Generated: _$tool"
    else
        rm -f "$target"
        echo "  Skipped: _$tool (generation failed)"
    fi
}

generate_completion "uv"            "uv generate-shell-completion zsh"
generate_completion "ruff"          "ruff generate-shell-completion zsh"
generate_completion "rustup"        "rustup completions zsh"
generate_completion "deno"          "deno completions zsh"
generate_completion "colima"        "colima completion zsh"
generate_completion "k9s"           "k9s completion zsh"
generate_completion "golangci-lint" "golangci-lint completion zsh"
generate_completion "gh"            "gh completion -s zsh"
generate_completion "docker"        "docker completion zsh"
generate_completion "kubectl"       "kubectl completion zsh"
generate_completion "helm"          "helm completion zsh"
generate_completion "chezmoi"       "chezmoi completion zsh"
generate_completion "just"          "just --completions zsh"

# rustup also provides cargo completions
if command -v rustup >/dev/null 2>&1 && [[ ! ( -n "$BREW_SITE" && -f "$BREW_SITE/_cargo" ) ]]; then
    if rustup completions zsh cargo > "$COMP_DIR/_cargo" 2>/dev/null; then
        echo "  Generated: _cargo (via rustup)"
    else
        rm -f "$COMP_DIR/_cargo"
    fi
fi

# pipx uses argcomplete
if command -v pipx >/dev/null 2>&1 && command -v register-python-argcomplete >/dev/null 2>&1; then
    if [[ -n "$BREW_SITE" && -f "$BREW_SITE/_pipx" ]]; then
        rm -f "$COMP_DIR/_pipx"
        echo "  Skipped: _pipx (Homebrew ships it)"
    elif register-python-argcomplete --shell zsh pipx > "$COMP_DIR/_pipx" 2>/dev/null; then
        echo "  Generated: _pipx"
    else
        rm -f "$COMP_DIR/_pipx"
    fi
fi

# ============================================================================
# 4. bash-style completions -- must be SOURCED, not placed in fpath
#    `complete -C` / `complete -F` register with bashcompinit at run time. A
#    file dropped in fpath without a leading #compdef line is never bound to
#    any command, which is why aws and npm silently had no completion.
# ============================================================================

if command -v aws_completer >/dev/null 2>&1; then
    rm -f "$COMP_DIR/_aws"  # remove the never-bound fpath file
    {
        echo
        echo "# AWS CLI (bash-style completer)"
        echo "autoload -Uz bashcompinit && bashcompinit"
        echo "complete -C \"$(command -v aws_completer)\" aws"
    } >> "$POST_FILE"
    echo "  Wired: aws (post-compinit)"
fi

if command -v npm >/dev/null 2>&1; then
    rm -f "$COMP_DIR/_npm"  # remove the never-bound fpath file
    NPM_COMP="$COMP_DIR/npm-completion.zsh"
    if npm completion > "$NPM_COMP" 2>/dev/null; then
        {
            echo
            echo "# npm (emits a shell function + complete registration)"
            echo "source \"$NPM_COMP\""
        } >> "$POST_FILE"
        echo "  Wired: npm (post-compinit)"
    else
        rm -f "$NPM_COMP"
    fi
fi

# ============================================================================
# 5. Temporal CLI + Cloud extension
#
#    `temporal` gets its _temporal from Homebrew, but the Cloud extension is a
#    separate `temporal-cloud` binary that the base CLI shells out to. The base
#    CLI does not know the plugin's command tree: `temporal __complete cloud`
#    returns nothing and `cloud` is absent from its top-level list, so
#    `temporal cloud <TAB>` completes nothing at all.
#
#    temporal-cloud has no `completion` subcommand, but it is cobra-based and
#    answers the hidden `__complete` protocol. So take cobra's own generated
#    script and patch its two dispatch points to route the `cloud` subtree at
#    the plugin. This lands in COMP_DIR, which sits ahead of site-functions in
#    fpath, deliberately shadowing Homebrew's stock _temporal.
#
#    If cobra's template ever shifts, the awk below matches nothing and exits
#    3; we then fall back to the unpatched script so plain `temporal`
#    completion keeps working, and say so.
# ============================================================================

if command -v temporal >/dev/null 2>&1; then
    TEMPORAL_RAW="$(mktemp -t temporal-comp.XXXXXX)"
    TEMPORAL_PATCH="$(mktemp -t temporal-patch.XXXXXX)"
    trap 'rm -f "$TEMPORAL_RAW" "$TEMPORAL_PATCH"' EXIT

    if ! temporal completion zsh > "$TEMPORAL_RAW" 2>/dev/null; then
        echo "  Skipped: _temporal (generation failed)"
    elif ! command -v temporal-cloud >/dev/null 2>&1; then
        cp "$TEMPORAL_RAW" "$COMP_DIR/_temporal"
        echo "  Generated: _temporal (no cloud extension installed)"
    else
        cat > "$TEMPORAL_PATCH" <<'AWKEOF'
$0 == "    requestComp=\"${words[1]} __complete ${words[2,-1]}\"" {
    print "    # Route the `cloud` subtree at the plugin binary: the base CLI"
    print "    # does not carry the extension's command tree."
    print "    if [[ ${words[2]} == cloud ]]; then"
    print "        requestComp=\"temporal-cloud __complete ${words[3,-1]}\""
    print "    else"
    print "        requestComp=\"${words[1]} __complete ${words[2,-1]}\""
    print "    fi"
    patched_req = 1
    next
}
$0 == "    out=$(eval ${requestComp} 2>/dev/null)" {
    print
    print "    # `cloud` is a plugin, so it is missing from the base CLI's own"
    print "    # top-level list. Put it back (the directive stays on the last line,"
    print "    # so prepending is safe)."
    print "    if (( CURRENT == 2 )) && (( $+commands[temporal-cloud] )); then"
    print "        out=$'cloud\\tManage Temporal Cloud resources\\n'\"${out}\""
    print "    fi"
    patched_out = 1
    next
}
{ print }
END { if (!patched_req || !patched_out) exit 3 }
AWKEOF

        if awk -f "$TEMPORAL_PATCH" "$TEMPORAL_RAW" > "$COMP_DIR/_temporal" 2>/dev/null; then
            echo "  Generated: _temporal (with cloud extension routing)"
        else
            cp "$TEMPORAL_RAW" "$COMP_DIR/_temporal"
            echo "  Generated: _temporal (UNPATCHED -- cobra template changed;"
            echo "             'temporal cloud <TAB>' will not complete. Use"
            echo "             'temporal-cloud <TAB>' or update this script.)"
        fi
    fi

    # The plugin binary is also directly invocable, so complete it on its own.
    if command -v temporal-cloud >/dev/null 2>&1; then
        if temporal-cloud __complete "" >/dev/null 2>&1; then
            # Rename every _temporal symbol first (this also covers
            # __temporal_debug and the funcstack guard, which compares against
            # the function name), then retarget the two binding lines. Order
            # matters: doing the header first would let the global rule rewrite
            # it a second time. No \b -- BSD sed lacks it.
            #
            # Filename is _temporal_cloud, NOT _temporal-cloud: compinit
            # autoloads the function named after the FILE, so a hyphenated name
            # would look for a _temporal-cloud function the script never defines
            # and silently complete nothing. #compdef still binds the hyphenated
            # command; the file name does not have to match it.
            rm -f "$COMP_DIR/_temporal-cloud"
            sed -e 's/_temporal/_temporal_cloud/g' \
                -e 's/^#compdef temporal$/#compdef temporal-cloud/' \
                -e 's/^compdef _temporal_cloud temporal$/compdef _temporal_cloud temporal-cloud/' \
                "$TEMPORAL_RAW" > "$COMP_DIR/_temporal_cloud"
            echo "  Generated: _temporal_cloud (binds temporal-cloud)"
        fi
    fi
fi

# ============================================================================
# 6. Retire the stray dump left by the old two-compinit layout
# ============================================================================
# ~/.zshrc used to run its own compinit before oh-my-zsh ran a second one. That
# first pass wrote ~/.zcompdump, which nothing reads now that oh-my-zsh owns the
# single compinit (it dumps to ~/.zcompdump-$SHORT_HOST-$ZSH_VERSION).
rm -f "$HOME/.zcompdump" "$HOME/.zcompdump.zwc"

echo "Completions generated successfully."
