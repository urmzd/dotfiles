{{- /* Work pack: a company-owned repo of plain files (env.zsh, gitconfig,      */}}
{{- /* ssh_config, Brewfile, AGENTS.md) that this repo hooks into but never     */}}
{{- /* tracks. Set work_pack_repo at `chezmoi init` on a work machine.          */}}
{{- if get . "work_pack_repo" }}
[".config/work"]
    type = "git-repo"
    url = {{ .work_pack_repo | quote }}
    refreshPeriod = "24h"
    pull.args = ["--ff-only"]
{{- end }}
