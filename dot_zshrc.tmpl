#!/usr/bin/env zsh

# Enable direnv hook BEFORE oh-my-zsh so per-directory env vars apply.
{{ if lookPath "direnv" -}}
export DIRENV_LOG_FORMAT=""
eval "$(direnv hook zsh)"
{{- end }}

# Enable Powerlevel10k instant prompt AFTER environment is set.
# Disable when using direnv or tmux to prevent conflicts.
if [[ -z "$TMUX" && -z "$DIRENV_DIR" && -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZSH=$HOME/.oh-my-zsh
ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(git zsh-syntax-highlighting zsh-completions)

# --- completion fpath ------------------------------------------------------
# Assemble fpath fully BEFORE oh-my-zsh, which runs the one and only compinit
# (oh-my-zsh.sh always calls it, and offers no flag to skip). Running another
# compinit here just paid for a second full scan of the same fpath -- zprof put
# the pair at ~340ms of a ~510ms cold start.
#
# Order is precedence: zsh takes the first _cmd it finds.
#   1. ~/.zsh/completions   deliberate overrides + tools brew has none for
#   2. brew site-functions  version-matched, updates with the formula
# The generator skips any tool Homebrew already ships, so (1) stays small and
# only shadows on purpose (currently just _temporal, to route `temporal cloud`).
typeset -U fpath  # brew site-functions and zsh-completions/src were each listed twice

# Written by chezmoi apply. fpath entries only -- anything needing compdef or
# bashcompinit lives in completions-post.zsh below, sourced after compinit.
[[ -f "$HOME/.zsh/brew-fpath.zsh" ]] && source "$HOME/.zsh/brew-fpath.zsh"
[[ -d "$HOME/.zsh/completions" ]] && fpath=("$HOME/.zsh/completions" $fpath)

fpath+=${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions/src

# Load oh-my-zsh AFTER environment is properly set. This is what runs compinit.
source "$ZSH/oh-my-zsh.sh"

# Completions that must be sourced rather than autoloaded from fpath: gcloud,
# and the bash-style `complete -C/-F` registrations for aws and npm. These call
# compdef/bashcompinit, so they only work once compinit has run. aws and npm
# previously sat in fpath with no leading #compdef tag, so compinit never bound
# them and neither actually completed anything.
[[ -f "$HOME/.zsh/completions-post.zsh" ]] && source "$HOME/.zsh/completions-post.zsh"

# Enable colors for ls - Cyberdream theme
# Load AFTER oh-my-zsh to prevent it from being overridden
{{- if .is_macos }}
# macOS: prefer GNU coreutils (gls/gdircolors from Homebrew), fall back to BSD ls.
# Cyberdream colors: blue (#5ea1ff), green (#5eff6c), cyan (#5ef1ff), magenta (#bd5eff)
if command -v gdircolors >/dev/null 2>&1; then
  eval "$(gdircolors -b)"
  # Customize LS_COLORS with Cyberdream palette (256-color codes)
  # di=38;5;75 (blue dirs), ex=38;5;83 (green executables), ln=38;5;87 (cyan symlinks)
  export LS_COLORS="di=38;5;75:ex=38;5;83:ln=38;5;87:or=38;5;141:mi=38;5;203:*.archive=38;5;141:*.tar=38;5;141:*.tgz=38;5;141:*.arc=38;5;141:*.arj=38;5;141:*.taz=38;5;141:*.lha=38;5;141:*.lz4=38;5;141:*.lzh=38;5;141:*.lzma=38;5;141:*.tlz=38;5;141:*.txz=38;5;141:*.tzo=38;5;141:*.t7z=38;5;141:*.zip=38;5;141:*.z=38;5;141:*.dz=38;5;141:*.gz=38;5;141:*.lrz=38;5;141:*.lz=38;5;141:*.lzop=38;5;141:*.xz=38;5;141:*.zst=38;5;141:*.zstd=38;5;141:*.bz2=38;5;141:*.bz=38;5;141:*.tbz=38;5;141:*.tbz2=38;5;141:*.tz=38;5;141:*.deb=38;5;141:*.rpm=38;5;141:*.jar=38;5;141:*.war=38;5;141:*.ear=38;5;141:*.rar=38;5;141:*.aces=38;5;141:*.7z=38;5;141:*.ace=38;5;141:*.apk=38;5;141:*.cpio=38;5;141:*.iso=38;5;141:*.cab=38;5;141:*.img=38;5;141:*.msi=38;5;141"
  alias ls='gls --color=auto'
elif ls --color=auto &>/dev/null 2>&1; then
  # GNU ls available
  if command -v dircolors >/dev/null 2>&1; then
    eval "$(dircolors -b)"
  fi
  # Customize LS_COLORS with Cyberdream palette
  export LS_COLORS="di=38;5;75:ex=38;5;83:ln=38;5;87:or=38;5;141:mi=38;5;203:*.archive=38;5;141:*.tar=38;5;141:*.tgz=38;5;141:*.arc=38;5;141:*.arj=38;5;141:*.taz=38;5;141:*.lha=38;5;141:*.lz4=38;5;141:*.lzh=38;5;141:*.lzma=38;5;141:*.tlz=38;5;141:*.txz=38;5;141:*.tzo=38;5;141:*.t7z=38;5;141:*.zip=38;5;141:*.z=38;5;141:*.dz=38;5;141:*.gz=38;5;141:*.lrz=38;5;141:*.lz=38;5;141:*.lzop=38;5;141:*.xz=38;5;141:*.zst=38;5;141:*.zstd=38;5;141:*.bz2=38;5;141:*.bz=38;5;141:*.tbz=38;5;141:*.tbz2=38;5;141:*.tz=38;5;141:*.deb=38;5;141:*.rpm=38;5;141:*.jar=38;5;141:*.war=38;5;141:*.ear=38;5;141:*.rar=38;5;141:*.aces=38;5;141:*.7z=38;5;141:*.ace=38;5;141:*.apk=38;5;141:*.cpio=38;5;141:*.iso=38;5;141:*.cab=38;5;141:*.img=38;5;141:*.msi=38;5;141"
  alias ls='ls --color=auto'
else
  # BSD ls (default macOS) - use LSCOLORS format
  alias ls='ls -G'
  export CLICOLOR=1
  # Cyberdream BSD equivalent: directories=blue (B), executables=green (x)
  export LSCOLORS=BxGxfxfxCxCxBxBxBxBxEx
fi
{{- else }}
# Linux: use GNU coreutils
if command -v dircolors >/dev/null 2>&1; then
  eval "$(dircolors -b)"
fi
alias ls='ls --color=auto'
{{- end }}

export EDITOR='nvim'

# Lets a terminal pinentry find this TTY when gpg signs a commit.
export GPG_TTY=$(tty)

alias vi="nvim"
alias vim="nvim"

# Dotfiles management: the `dotfiles` binary (built from cli/ in this repo), installed
# by run_once_after_install-stack. `dotfiles --help` lists the commands.

# Kubernetes aliases (Colima with k3s)
alias k8s-up="colima start --kubernetes"
alias k8s-down="colima stop"

# Cloud authentication aliases
# GCP: User and application-default login
alias gcpsso="gcloud auth login && gcloud auth application-default login"

# Snowflake: Generate JWT and export as SNOWFLAKE_TOKEN
unalias snowsso 2>/dev/null
function snowsso() {
  local token
  token=$(snow connection generate-jwt) || { echo "Failed to generate JWT"; return 1; }
  export SNOWFLAKE_TOKEN="${token}"
  echo "SNOWFLAKE_TOKEN exported"
}

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# FZF integration
{{ if lookPath "fzf" -}}
source <(fzf --zsh)
# Back fzf with fd so fuzzy finding respects .gitignore
# (fzf's built-in walker does not read .gitignore). Escape hatch: fd -I / -u.
# Runtime check (not lookPath) so this activates once brew bundle installs fd.
if command -v fd >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git'
  _fzf_compgen_path() { fd --hidden --follow --exclude .git . "$1"; }
  _fzf_compgen_dir() { fd --type d --hidden --follow --exclude .git . "$1"; }
fi
{{- end }}

# fnm (Fast Node Manager) adds node/npm shims to PATH, auto-switches on cd.
{{ if lookPath "fnm" -}}
eval "$(fnm env --use-on-cd --shell zsh)"

# fnm links one dir per shell into ~/.local/state/fnm_multishells and never
# removes them (1,400+ had piled up by 2026-10). Prune links whose process is
# no longer a shell, in the background so startup stays fast. Checking the
# command, not just the pid, matters: pids get reused by unrelated processes.
_fnm_prune_multishells() {
  local dir=${FNM_MULTISHELL_PATH:h} link pid comm
  [[ -n $FNM_MULTISHELL_PATH && -d $dir ]] || return 0
  for link in $dir/*(N@); do
    [[ $link == $FNM_MULTISHELL_PATH ]] && continue
    pid=${${link:t}%%_*}
    comm=$(ps -o comm= -p $pid 2>/dev/null)
    [[ $comm == *zsh* || $comm == *bash* || $comm == *fish* ]] || rm -f -- $link
  done
}
_fnm_prune_multishells &!
{{- end }}

{{ if lookPath "mise" -}}
# mise activates per-project runtimes (JDK, Scala, ...) declared in .mise.toml
# on cd. Deliberately AFTER fnm: mise can manage node as well, and whichever
# activates last wins on PATH. Node stays with fnm, so keep node out of any
# .mise.toml unless you mean to hand it over.
#
# Comment inside the guard, not above it: mise is optional here (the `mise`
# package in catalog.toml), and a comment outside would render
# into ~/.zshrc on machines without mise, describing an activation that is not
# happening.
eval "$(mise activate zsh)"
{{- end }}

# Load local environment if exists
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# Source all function files from ~/.zsh/functions
if [[ -d "$HOME/.zsh/functions" ]]; then
  for func_file in "$HOME/.zsh/functions"/*.zsh(N); do
    source "$func_file"
  done
fi
