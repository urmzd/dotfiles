# Chezmoi configuration template
# This file configures chezmoi behavior and contains template variables

{{- /* Every value below is asked at most once and only when it cannot be      */}}
{{- /* derived. Re-running `chezmoi init` on a configured machine reuses saved  */}}
{{- /* values, and configs written before a key existed are migrated from the   */}}
{{- /* legacy keys instead of re-prompting.                                     */}}

{{- /* ---- Identity ------------------------------------------------------- */}}
{{- $default_name := "" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $default_name = output "id" "-F" | trim -}}
{{- end -}}
{{- $name := promptStringOnce . "name" "Full name" $default_name -}}
{{- $email := promptStringOnce . "email" "Personal email (commits in this repo and ~/personal)" -}}

{{- /* GitHub user comes from this repo's origin remote; ask only if unparseable. */}}
{{- $github_username := get . "github_username" -}}
{{- if not $github_username -}}
{{-   $remote := output "git" "-C" .chezmoi.sourceDir "remote" "get-url" "origin" | trim -}}
{{-   $github_username = regexReplaceAll "^.*github\\.com[:/]([^/]+)/.*$" $remote "${1}" -}}
{{-   if or (eq $github_username $remote) (not $github_username) -}}
{{-     $github_username = promptString "GitHub username" -}}
{{-   end -}}
{{- end -}}

{{- /* GPG keys are matched by email UID: personal key <- personal email,     */}}
{{- /* work key <- work email. Prompted only when no matching key exists.      */}}
{{- $has_gpg := lookPath "gpg" -}}
{{- $gpg_signing_key := "" -}}
{{- if hasKey . "gpg_signing_key" -}}
{{-   $gpg_signing_key = .gpg_signing_key -}}
{{- else -}}
{{-   if $has_gpg -}}
{{-     $gpg_signing_key = output "sh" "-c" "gpg --list-secret-keys --with-colons -- \"<$1>\" 2>/dev/null || true" "sh" $email | regexFind "fpr:+[0-9A-F]{40}" | regexFind "[0-9A-F]{40}" -}}
{{-   end -}}
{{-   if not $gpg_signing_key -}}
{{-     $gpg_signing_key = promptString "Personal GPG signing key ID (optional)" "" -}}
{{-   end -}}
{{- end -}}
{{- /* SSH signing is never prompted; set ssh_signing_key in chezmoi.toml to use it. */}}
{{- $ssh_signing_key := get . "ssh_signing_key" | default "" -}}

{{- /* ---- Machine -------------------------------------------------------- */}}
{{- /* One choice replaces the old is_personal/is_work pair. Legacy configs    */}}
{{- /* migrate from is_work without a prompt.                                  */}}
{{- $machine := get . "machine" -}}
{{- if not $machine -}}
{{-   if hasKey . "is_work" -}}
{{-     $machine = ternary "work" "personal" .is_work -}}
{{-   else -}}
{{-     $machine = promptChoice "Machine type" (list "personal" "work") "personal" -}}
{{-   end -}}
{{- end -}}
{{- $is_work := eq $machine "work" -}}

{{- $work_email := $email -}}
{{- $work_pack_repo := "" -}}
{{- $work_signing_key := "" -}}
{{- $use_secrets := false -}}
{{- if $is_work -}}
{{-   $work_email = promptStringOnce . "work_email" "Work email (default for every repo outside ~/personal)" $email -}}
{{-   if hasKey . "work_signing_key" -}}
{{-     $work_signing_key = .work_signing_key -}}
{{-   else -}}
{{-     if $has_gpg -}}
{{-       $work_signing_key = output "sh" "-c" "gpg --list-secret-keys --with-colons -- \"<$1>\" 2>/dev/null || true" "sh" $work_email | regexFind "fpr:+[0-9A-F]{40}" | regexFind "[0-9A-F]{40}" -}}
{{-     end -}}
{{-     if not $work_signing_key -}}
{{-       $work_signing_key = promptString "Work GPG signing key ID; your personal key is never used for work (optional)" "" -}}
{{-     end -}}
{{-   end -}}
{{-   $work_pack_repo = promptStringOnce . "work_pack_repo" "Work pack git URL to clone into ~/.config/work (optional)" "" -}}
{{- else -}}
{{-   $use_secrets = promptBoolOnce . "use_secrets" "Use age encryption + 1Password CLI for secrets (y/n)" false -}}
{{- end -}}

{{- $install_cortex := promptBoolOnce . "install_cortex" "Install Snowflake Cortex Code CLI (y/n)" false -}}

{{- /* ---- Packages ------------------------------------------------------- */}}
{{- /* The preset seeds the group flags on first init only. After that the     */}}
{{- /* saved flags win, so `dotfiles update groups` edits survive re-init.     */}}
{{- $preset := promptChoiceOnce . "package_preset" "Package preset (minimal: core CLI + editor; standard: + cloud/infra + fonts; full: + mobile dev)" (list "minimal" "standard" "full") "standard" -}}
{{- $groups := dict "install_cloud" (ne $preset "minimal") "install_fonts" (ne $preset "minimal") "install_mobile" (eq $preset "full") -}}
{{- range $key, $_ := $groups -}}
{{-   if hasKey $ $key }}{{ $_ := set $groups $key (index $ $key) }}{{ end -}}
{{- end -}}

{{- /* Off-ladder extras (heavy, rarely used): one question on first init.    */}}
{{- $install_alt_langs := false -}}
{{- $install_temporal := false -}}
{{- if or (hasKey . "install_alt_langs") (hasKey . "install_temporal") -}}
{{-   $install_alt_langs = get . "install_alt_langs" | default false -}}
{{-   $install_temporal = get . "install_temporal" | default false -}}
{{- else -}}
{{-   $extras := promptString "Extra package groups; separate with commas (optional; alt-langs: mise/scala-cli/zig; temporal: Temporal CLI)" "" | nospace | splitList "," -}}
{{-   $install_alt_langs = has "alt-langs" $extras -}}
{{-   $install_temporal = has "temporal" $extras -}}
{{- end -}}
{{- $pkg_exclude := promptStringOnce . "pkg_exclude" "Packages to exclude by name; separate with commas (optional; e.g. k9s)" "" -}}

{{- if $use_secrets }}
encryption = "age"
{{- end }}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    work_email = {{ $work_email | quote }}
    github_username = {{ $github_username | quote }}
    gpg_signing_key = {{ $gpg_signing_key | quote }}
    ssh_signing_key = {{ $ssh_signing_key | quote }}
    # Signs default (work) repos on a work machine; the personal key never does.
    work_signing_key = {{ $work_signing_key | quote }}

    # Machine type: "personal" or "work". is_personal/is_work are derived.
    machine = {{ $machine | quote }}
    is_personal = {{ not $is_work }}
    is_work = {{ $is_work }}
    # Shareable company overlay cloned to ~/.config/work (see .chezmoiexternal.toml.tmpl)
    work_pack_repo = {{ $work_pack_repo | quote }}

    # Feature flags
    use_secrets = {{ $use_secrets }}
    install_cortex = {{ $install_cortex }}

    # Package selection: preset seeds the groups on first init; edit freely after
    package_preset = {{ $preset | quote }}
    install_cloud = {{ $groups.install_cloud }}
    install_fonts = {{ $groups.install_fonts }}
    install_mobile = {{ $groups.install_mobile }}
    install_alt_langs = {{ $install_alt_langs }}
    install_temporal = {{ $install_temporal }}
    pkg_exclude = {{ $pkg_exclude | quote }}

    # System detection
    is_macos = {{ eq .chezmoi.os "darwin" }}
    is_linux = {{ eq .chezmoi.os "linux" }}
    is_wsl = {{ env "WSL_DISTRO_NAME" | not | not }}

    # Package manager detection
    has_homebrew = {{ lookPath "brew" | not | not }}
    has_apt = {{ lookPath "apt" | not | not }}

    # Development tools detection
    has_direnv = {{ lookPath "direnv" | not | not }}

[git]
    autoCommit = true
    autoPush = false

{{- if $use_secrets }}
[age]
    suffix = ".age"
    identity = "~/.config/age/key.txt"
    recipient = "age1g2gr4rddcar2335xdqu6l2t40dpmmulq9jh7ne5873wa03fcxsdqv5mrk2"  # pragma: allowlist secret
{{- end }}

[cd]
    command = "code"

[edit]
    command = "nvim"

[merge]
    command = "nvim"
    args = ["-d", "{{ "{{ .Destination }}" }}", "{{ "{{ .Source }}" }}", "{{ "{{ .Target }}" }}"]

[diff]
    command = "nvim"
    args = ["-d", "{{ "{{ .Destination }}" }}", "{{ "{{ .Target }}" }}"]

# Template options
[template]
    options = ["missingkey=error"]
