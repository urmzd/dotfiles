# Chezmoi configuration template
# This file configures chezmoi behavior and contains template variables

{{- /* Every value below is asked at most once and only when it cannot be      */}}
{{- /* derived. Re-running `chezmoi init` on a configured machine reuses saved  */}}
{{- /* values, and configs written before a key existed are migrated from the   */}}
{{- /* legacy keys instead of re-prompting.                                     */}}

{{- /* ---- Identity ------------------------------------------------------- */}}
{{- $default_name := "" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $default_name = output "id" "-F" | trim -}}
{{- end -}}
{{- $name := promptStringOnce . "name" "Full name" $default_name -}}

{{- /* ---- Machine -------------------------------------------------------- */}}
{{- /* Asked before any email: it decides which identity this machine has.     */}}
{{- /* Legacy configs migrate from is_work without a prompt.                   */}}
{{- $machine := get . "machine" -}}
{{- if not $machine -}}
{{-   if hasKey . "is_work" -}}
{{-     $machine = ternary "work" "personal" .is_work -}}
{{-   else -}}
{{-     $machine = promptChoice "Machine type" (list "personal" "work") "personal" -}}
{{-   end -}}
{{- end -}}
{{- $is_work := eq $machine "work" -}}

{{- /* GitHub account this machine pushes as. Personal: this repo's owner,    */}}
{{- /* read from the origin remote. Work: the separate work account, asked    */}}
{{- /* once (the dotfiles repo is public, so pulling it needs no account).    */}}
{{- $github_username := get . "github_username" -}}
{{- if not $github_username -}}
{{-   if $is_work -}}
{{-     $github_username = promptString "Work GitHub username (the account this machine pushes as)" -}}
{{-   else -}}
{{-     $remote := output "git" "-C" .chezmoi.sourceDir "remote" "get-url" "origin" | trim -}}
{{-     $github_username = regexReplaceAll "^.*github\\.com[:/]([^/]+)/.*$" $remote "${1}" -}}
{{-     if or (eq $github_username $remote) (not $github_username) -}}
{{-       $github_username = promptString "GitHub username" -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

{{- /* One identity per machine. A work machine only pulls this repo (edits    */}}
{{- /* happen on a personal machine), so it never asks for a personal email or */}}
{{- /* key. GPG keys are matched by email UID; prompted only when none match.  */}}
{{- $has_gpg := lookPath "gpg" -}}
{{- $email := get . "email" | default "" -}}
{{- $work_email := get . "work_email" | default "" -}}
{{- $gpg_signing_key := get . "gpg_signing_key" | default "" -}}
{{- $work_signing_key := get . "work_signing_key" | default "" -}}
{{- /* Packs: an ordered list of overlays (see .chezmoitemplates/packs).    */}}
{{- /* Configs from before the list keep their single work_pack (or older   */}}
{{- /* work_pack_repo) as a one-pack list, unasked; a hand-made             */}}
{{- /* ~/.config/work on a work machine with neither set becomes the pack.   */}}
{{- $packs := list -}}
{{- $legacy_pack := get . "work_pack" | default (get . "work_pack_repo" | default "") -}}
{{- $ask_packs := false -}}
{{- if hasKey . "packs" -}}
{{-   $packs = .packs -}}
{{- else if $legacy_pack -}}
{{-   $packs = list $legacy_pack -}}
{{- else if or (hasKey . "work_pack") (hasKey . "work_pack_repo") -}}
{{-   if and $is_work (stat (joinPath .chezmoi.homeDir ".config/work")) }}{{ $packs = list "~/.config/work" }}{{ end -}}
{{- else -}}
{{-   $ask_packs = true -}}
{{- end -}}
{{- $use_secrets := false -}}
{{- if $is_work -}}
{{-   $work_email = promptStringOnce . "work_email" "Work email for git commits" -}}
{{- /* Detect whenever no key is saved, so creating the key and re-running  */ -}}
{{- /* `chezmoi init` picks it up; prompt only on the first init.           */ -}}
{{-   if and (not $work_signing_key) $has_gpg -}}
{{-     $work_signing_key = output "sh" "-c" "gpg --list-secret-keys --with-colons -- \"<$1>\" 2>/dev/null || true" "sh" $work_email | regexFind "fpr:+[0-9A-F]{40}" | regexFind "[0-9A-F]{40}" -}}
{{-   end -}}
{{-   if and (not $work_signing_key) (not (hasKey . "work_signing_key")) -}}
{{-     $work_signing_key = promptString "Work GPG signing key ID (optional)" "" -}}
{{-   end -}}
{{-   if $ask_packs -}}
{{-     range (promptString "Packs, in order, comma-separated: git URL, URL//folder (one folder of a repo, e.g. acme.git//backend-engineer), or local folder (optional)" "" | splitList ",") -}}
{{-       if trim . }}{{ $packs = append $packs (trim .) }}{{ end -}}
{{-     end -}}
{{-   end -}}
{{- else -}}
{{-   $email = promptStringOnce . "email" "Email for git commits" -}}
{{-   if and (not $gpg_signing_key) $has_gpg -}}
{{-     $gpg_signing_key = output "sh" "-c" "gpg --list-secret-keys --with-colons -- \"<$1>\" 2>/dev/null || true" "sh" $email | regexFind "fpr:+[0-9A-F]{40}" | regexFind "[0-9A-F]{40}" -}}
{{-   end -}}
{{-   if and (not $gpg_signing_key) (not (hasKey . "gpg_signing_key")) -}}
{{-     $gpg_signing_key = promptString "GPG signing key ID (optional)" "" -}}
{{-   end -}}
{{-   $use_secrets = promptBoolOnce . "use_secrets" "Use age encryption + 1Password CLI for secrets (y/n)" false -}}
{{- end -}}
{{- /* SSH signing is never prompted; set ssh_signing_key in chezmoi.toml to use it. */}}
{{- $ssh_signing_key := get . "ssh_signing_key" | default "" -}}

{{- $install_cortex := promptBoolOnce . "install_cortex" "Install Snowflake Cortex Code CLI (y/n)" false -}}

{{- /* ---- Packages ------------------------------------------------------- */}}
{{- /* Optional packages are catalog.toml ids in `packages`, edited later with  */}}
{{- /* `dotfiles package`. First init seeds them from a preset; configs from   */}}
{{- /* before the catalog migrate from their install_* group flags instead.    */}}
{{- $catalog := include "catalog.toml" | fromToml -}}
{{- $packages := list -}}
{{- if hasKey . "packages" -}}
{{-   $packages = .packages -}}
{{- else if hasKey . "install_cloud" -}}
{{-   $legacy := dict "install_cloud" (list "docker" "kubernetes" "terraform" "runpod") "install_fonts" (list "nerd-fonts") "install_mobile" (list "android" "cocoapods") "install_alt_langs" (list "zig" "scala" "mise") "install_temporal" (list "temporal") -}}
{{-   range $flag, $ids := $legacy -}}
{{-     if get $ $flag }}{{ $packages = concat $packages $ids }}{{ end -}}
{{-   end -}}
{{-   if not $is_work }}{{ $packages = append $packages "obsidian" }}{{ end -}}
{{- else -}}
{{-   $preset := promptChoiceOnce . "package_preset" "Package preset; refine later with `dotfiles package` (minimal: core CLI, editor, core agent skills; standard: + cloud, fonts, developer skills; full: + mobile, framework skills; custom: pick bundles)" (list "minimal" "standard" "full" "custom") "standard" -}}
{{-   $bundles := list -}}
{{-   if eq $preset "custom" -}}
{{-     $names := list -}}
{{-     range $catalog.bundle }}{{ $names = append $names .id }}{{ end -}}
{{-     $bundles = promptMultichoice "Bundles (space to toggle)" $names (list "cloud" "dev-skills") -}}
{{-   else -}}
{{-     range $catalog.bundle }}{{ if has $preset (get . "presets" | default list) }}{{ $bundles = append $bundles .id }}{{ end }}{{ end -}}
{{-   end -}}
{{-   range $catalog.bundle }}{{ if has .id $bundles }}{{ $packages = concat $packages .packages }}{{ end }}{{ end -}}
{{-   /* Package-level presets (fonts, notes): custom gets the standard ones. */ -}}
{{-   $preset_pkgs := ternary "standard" $preset (eq $preset "custom") -}}
{{-   range $catalog.package -}}
{{-     if and (has $preset_pkgs (get . "presets" | default list)) (has $machine (get . "machines" | default (list "personal" "work"))) -}}
{{-       $packages = append $packages .id -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- /* Skill packs and teasr/oag joined the catalog later; configs from       */}}
{{- /* before keep what the old scripts always installed, once, unasked.      */}}
{{- if and (not (hasKey . "skills_seeded")) (or (hasKey . "packages") (hasKey . "install_cloud")) -}}
{{-   $packages = concat $packages (list "teasr" "oag") -}}
{{-   range $catalog.package }}{{ if get . "skills" }}{{ $packages = append $packages .id }}{{ end }}{{ end -}}
{{- end -}}
{{- /* AI coding agents (catalog category "agents"): a multi-select on first */}}
{{- /* init. Configs from before they joined the catalog get the set the old  */}}
{{- /* install script always installed, once, with no question.               */}}
{{- $agent_ids := list -}}
{{- range $catalog.package }}{{ if eq .category "agents" }}{{ $agent_ids = append $agent_ids .id }}{{ end }}{{ end -}}
{{- if not (hasKey . "agents_seeded") -}}
{{-   if or (hasKey . "packages") (hasKey . "install_cloud") -}}
{{-     $packages = concat $packages (list "claude-code" "codex" "copilot" "agy" "opencode") -}}
{{-   else -}}
{{-     $packages = concat $packages (promptMultichoice "AI coding CLIs to install (more later with `dotfiles package`)" $agent_ids (list "claude-code" "codex")) -}}
{{-   end -}}
{{- end -}}
{{- $pkg_exclude := promptStringOnce . "pkg_exclude" "Packages to exclude by name; separate with commas (optional; e.g. k9s)" "" -}}

{{- if $use_secrets }}
encryption = "age"
{{- end }}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    work_email = {{ $work_email | quote }}
    github_username = {{ $github_username | quote }}
    gpg_signing_key = {{ $gpg_signing_key | quote }}
    ssh_signing_key = {{ $ssh_signing_key | quote }}
    # Work machines sign with this; gpg_signing_key is for personal machines.
    work_signing_key = {{ $work_signing_key | quote }}

    # Machine type: "personal" or "work". is_personal/is_work are derived.
    machine = {{ $machine | quote }}
    is_personal = {{ not $is_work }}
    is_work = {{ $is_work }}
    # Packs (company, team, personal overlays), stacked in order: git URL,
    # URL//folder, or local folder. Edit with `dotfiles pack`.
    packs = [{{ range $i, $p := $packs }}{{ if $i }}, {{ end }}{{ $p | quote }}{{ end }}]
    # Color theme for Ghostty, Neovim, tmux, and dotfiles output: a name from
    # themes/ or a pack; empty follows the last pack theme, else cyberdream.
    # Change with `dotfiles theme set <name>`.
    theme = {{ get . "theme" | default "" | quote }}

    # Feature flags
    use_secrets = {{ $use_secrets }}
    install_cortex = {{ $install_cortex }}

    # Optional packages: catalog.toml ids. Edit with `dotfiles package`.
    packages = {{ $packages | uniq | sortAlpha | toToml }}
    agents_seeded = true
    skills_seeded = true
    pkg_exclude = {{ $pkg_exclude | quote }}

    # System detection
    is_macos = {{ eq .chezmoi.os "darwin" }}
    is_linux = {{ eq .chezmoi.os "linux" }}
    is_wsl = {{ env "WSL_DISTRO_NAME" | not | not }}

    # Package manager detection
    has_homebrew = {{ lookPath "brew" | not | not }}
    has_apt = {{ lookPath "apt" | not | not }}

    # Development tools detection
    has_direnv = {{ lookPath "direnv" | not | not }}

[git]
    autoCommit = true
    autoPush = false

{{- if $use_secrets }}
[age]
    suffix = ".age"
    identity = "~/.config/age/key.txt"
    recipient = "age1g2gr4rddcar2335xdqu6l2t40dpmmulq9jh7ne5873wa03fcxsdqv5mrk2"  # pragma: allowlist secret
{{- end }}

{{- /* `chezmoi cd` opens VS Code when its `code` command exists at init;  */}}
{{- /* otherwise chezmoi's default, a shell in the source directory.        */}}
{{- if lookPath "code" }}
[cd]
    command = "code"
{{- end }}

[edit]
    command = "nvim"

[merge]
    command = "nvim"
    args = ["-d", "{{ "{{ .Destination }}" }}", "{{ "{{ .Source }}" }}", "{{ "{{ .Target }}" }}"]

[diff]
    command = "nvim"
    args = ["-d", "{{ "{{ .Destination }}" }}", "{{ "{{ .Target }}" }}"]

# Template options
[template]
    options = ["missingkey=error"]
