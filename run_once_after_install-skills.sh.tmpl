#!/usr/bin/env bash
{{ includeTemplate "bash-modern.sh" . }}
# Install agent skills and agents via agentspec CLI
set -euo pipefail
{{ includeTemplate "ui.sh" . }}
ui_section "Agent skills"

if ! command -v agentspec &>/dev/null; then
    if ! ui_run "installed agentspec" fetch_and_run https://raw.githubusercontent.com/urmzd/agentspec/main/install.sh sh; then
        ui_hint "skills sync skipped; rerun chezmoi apply once the network is back"
        exit 0
    fi
fi

# Local skills and agents from dotfiles repo (dot_agents/ -> ~/.agents/), then
# third-party skills. A failed source is reported and skipped, not fatal.
SOURCES=(
    "$HOME/.agents"   # deployed by chezmoi; see run_after_sync-agent-resources for why not the source
    vercel-labs/skills
    vercel/ai-elements
    vercel/streamdown
    google-gemini/gemini-skills
    better-auth/skills@better-auth/best-practices
    vercel/ai@skills/use-ai-sdk
    fastapi/fastapi@fastapi/.agents/skills/fastapi
    github/gh-stack@skills/gh-stack
)
for src in ${SOURCES[@]+"${SOURCES[@]}"}; do
    label="$src"
    [[ "$src" == /* ]] && label="dotfiles skills and agents"
    ui_run "added $label" agentspec manage add "$src" --all-tools || true
done

# Sync: discover, link, and verify all resources
ui_run "linked into every installed AI tool" agentspec sync --fast || true
