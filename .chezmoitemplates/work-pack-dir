{{- /* Resolved work pack folder (no trailing newline). work_pack may be:   */ -}}
{{- /*   empty      -> ~/.config/work (hand-made or absent; hooks no-op)     */ -}}
{{- /*   a git URL  -> cloned into ~/.config/work by run_after_sync-work-pack */ -}}
{{- /*   a path     -> used in place (absolute, or starting with ~)          */ -}}
{{- $pack := get . "work_pack" | default "" -}}
{{- if hasPrefix "~" $pack -}}
{{-   joinPath .chezmoi.homeDir (trimPrefix "~" $pack) -}}
{{- else if hasPrefix "/" $pack -}}
{{-   $pack -}}
{{- else -}}
{{-   joinPath .chezmoi.homeDir ".config/work" -}}
{{- end -}}