# Brewfile - macOS packages managed by Homebrew
# Run: brew bundle --file=Brewfile
#
# Source of truth on macOS for everything except:
#   - gcloud / aws-cli   -> run_onchange_after_install-cloud-clis.sh.tmpl (pinned upstream)
#   - cortex             -> run_onchange_after_install-cortex.sh.tmpl   (pinned upstream)
#   - AI coding CLIs     -> catalog.toml category "agents" (picked per machine)
#   - company tools      -> <work pack>/Brewfile (optional work pack, appended at install time)
#   - Python / Rust      -> uv / rustup (curl-installed in run_once_before_install-packages-v2.sh.tmpl)
#
# Optional packages come from catalog.toml: the ids listed in [data].packages
# (local chezmoi.toml, edited with `dotfiles package`) are rendered at the end
# of this file. `pkg_exclude` drops individual packages by name at install time.

# Core CLI
brew "git"
brew "gh"
brew "fzf"
brew "ripgrep"
brew "fd"  # gitignore-aware find; backs FZF_DEFAULT_COMMAND and Telescope find_files
brew "tree"
brew "jq"
brew "yq"
brew "just"
brew "direnv"
brew "chezmoi"
brew "tmux"
brew "gnupg"
brew "pinentry-mac"  # GUI passphrase prompt so commit signing works without a TTY (editors, agents)
brew "tree-sitter-cli"
brew "uv"
brew "tealdeer"
brew "coreutils"  # Provides gls/gdircolors used in dot_zshrc.tmpl color setup
brew "reattach-to-user-namespace"  # tmux clipboard integration on macOS

{{- if .use_secrets }}

# Secrets
cask "1password-cli"  # `op` CLI; pairs with manage-secrets skill (1Password desktop app needed for biometric unlock)
{{- end }}

# Runtimes / language tooling
brew "fnm"            # Node version manager
brew "deno"
brew "go"
brew "golangci-lint"
brew "lua"
brew "luarocks"
brew "luacheck"
brew "stylua"

# Editor
brew "neovim", args: ["HEAD"]  # Extensible Vim-based text editor (0.12-dev)

# Build Tools
brew "cmake"    # Cross-platform build system generator
brew "gettext"  # GNU internationalization and localization support

# Terminal
# Terminal: ghostty (installed outside Homebrew)

# Optional packages selected from catalog.toml
{{- $selected := get . "packages" | default list }}
{{- range (include "catalog.toml" | fromToml).package }}
{{-   if and (has .id $selected) (or (get . "brew") (get . "cask") (get . "npm") (get . "uv")) }}

# {{ .name }} ({{ .id }}): {{ .description }}
{{-     range (get . "tap" | default list) }}
tap {{ . | quote }}
{{-     end }}
{{-     range (get . "brew" | default list) }}
brew {{ . | quote }}
{{-     end }}
{{-     $adopt := get . "adopt" }}
{{-     range (get . "cask" | default list) }}
cask {{ . | quote }}{{ if $adopt }}, args: { adopt: true }{{ end }}
{{-     end }}
{{-     range (get . "npm" | default list) }}
npm {{ . | quote }}
{{-     end }}
{{-     range (get . "uv" | default list) }}
uv {{ . | quote }}
{{-     end }}
{{-   end }}
{{- end }}
