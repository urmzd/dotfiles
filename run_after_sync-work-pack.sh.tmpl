#!/usr/bin/env bash
{{ includeTemplate "bash-modern.sh" . }}
# Fetch the optional work pack, then validate its catalog.toml. It never fails
# the apply: a missing, private, or unreachable pack only warns, so a new
# laptop can apply everything before its work SSH key exists
# (`dotfiles identity`), then pick the pack up later.
#   work_pack empty     -> nothing to fetch (a hand-made ~/.config/work still works)
#   work_pack local     -> used in place; warn if the folder is missing
#   work_pack git URL   -> clone into ~/.config/work, then fast-forward daily
{{- $pack := get . "work_pack" | default "" }}
{{- $dir := includeTemplate "work-pack-dir" . }}
{{- if .is_work }}
set -u
{{ includeTemplate "ui.sh" . }}
pack={{ $pack | quote }}
dir={{ $dir | quote }}
shown=0
section() { [ "$shown" -eq 1 ] || ui_section "Work pack"; shown=1; }

sync_pack() {
{{- if not $pack }}
    return 0
{{- else if or (hasPrefix "/" $pack) (hasPrefix "~" $pack) }}
    if [ ! -d "$dir" ]; then
        section
        ui_warn "work pack folder $dir not found; its hooks stay inactive"
        ui_hint "create it, or change work_pack in ~/.config/chezmoi/chezmoi.toml"
    fi
{{- else }}
    # Never stop to ask for credentials: fail fast and warn instead.
    local err
    export GIT_TERMINAL_PROMPT=0
    export GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=10"
    err="$(mktemp "${TMPDIR:-/tmp}/work-pack.XXXXXX")"
    if [ -d "$dir/.git" ]; then
        # Fast-forward at most once a day; FETCH_HEAD records the last fetch.
        if [ -f "$dir/.git/FETCH_HEAD" ] && [ -z "$(find "$dir/.git/FETCH_HEAD" -mmin +1440 2>/dev/null)" ]; then
            rm -f "$err"
            return 0
        fi
        section
        if git -C "$dir" pull --ff-only --quiet 2>"$err"; then
            ui_ok "updated $dir"
        else
            ui_warn "could not update $dir; keeping the current copy"
            ui_hint "$(head -1 "$err")"
        fi
    elif [ -e "$dir" ] && [ -n "$(ls -A "$dir" 2>/dev/null)" ]; then
        section
        ui_warn "$dir exists and is not a git checkout; leaving it alone"
        ui_hint "move it aside to clone $pack there, or set work_pack to its path"
    else
        section
        if git clone --quiet "$pack" "$dir" 2>"$err"; then
            touch "$dir/.git/FETCH_HEAD"  # counts as today's fetch
            ui_ok "cloned $pack into $dir"
            ui_hint "its AGENTS.md, Brewfile, and catalog take effect on the next chezmoi apply"
        else
            ui_warn "could not clone $pack; the rest of the apply is unaffected"
            ui_hint "$(head -1 "$err")"
            ui_hint "check access (dotfiles identity sets up this machine's SSH key), then rerun: chezmoi apply"
        fi
    fi
    rm -f "$err"
{{- end }}
}

# The package templates read a validated copy of the pack's catalog.toml,
# never the file itself, so a broken company file cannot break every apply.
# Same checks as the dotfiles CLI: valid TOML, required string fields, and no
# id that the dotfiles catalog already uses. A bad file keeps the last good copy.
sync_catalog() {
    local src="$dir/catalog.toml" copy="$HOME/.local/share/dotfiles/work-catalog.toml" py err
    if [ ! -f "$src" ]; then
        rm -f "$copy"
        return 0
    fi
    py="$HOME/.local/share/dotfiles/python/bin/python3"
    [ -x "$py" ] || py="$(command -v python3 2>/dev/null || true)"
    if [ -z "$py" ] || ! "$py" -c 'import tomllib' >/dev/null 2>&1; then
        section
        ui_warn "no Python 3.11+ to check the work catalog; its packages wait"
        ui_hint "dotfiles package list (the CLI checks and loads it too)"
        return 0
    fi
    cmp -s "$src" "$copy" 2>/dev/null && return 0
    err="$(mktemp "${TMPDIR:-/tmp}/work-catalog.XXXXXX")"
    if "$py" - {{ joinPath .chezmoi.sourceDir "catalog.toml" | quote }} "$src" >/dev/null 2>"$err" <<'PY'
import sys, tomllib
base = {p["id"] for p in tomllib.load(open(sys.argv[1], "rb")).get("package", [])}
seen = set()
for i, p in enumerate(tomllib.load(open(sys.argv[2], "rb")).get("package", [])):
    for key in ("id", "name", "description", "category"):
        if not isinstance(p.get(key), str):
            sys.exit(f"package #{i + 1}: missing string field `{key}`")
    if p["id"] in base or p["id"] in seen:
        sys.exit(f"id `{p['id']}` is already used")
    seen.add(p["id"])
PY
    then
        mkdir -p "$(dirname "$copy")"
        cp "$src" "$copy"
        section
        ui_ok "work catalog loaded ($src)"
        ui_hint "its packages install on the next chezmoi apply; see them: dotfiles package list"
    else
        section
        ui_warn "work catalog ignored: $(tail -1 "$err")"
        ui_hint "fix $src, then: dotfiles doctor"
    fi
    rm -f "$err"
}

sync_pack
sync_catalog
exit 0
{{- end }}
