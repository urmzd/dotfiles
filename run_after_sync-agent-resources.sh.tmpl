#!/usr/bin/env bash
{{ includeTemplate "bash-modern.sh" . }}
# Keep local agent skills and agents managed after every chezmoi apply.
# Runs on every apply, so it prints one summary line, not agentspec's full report.
set -euo pipefail
{{ includeTemplate "ui.sh" . }}
ui_section "Agent resources"

if ! command -v agentspec >/dev/null 2>&1; then
    ui_skip "agentspec not installed; skipping sync"
    exit 0
fi

# Skills of deselected skill packs: .chezmoiignore stops deploying them, but
# chezmoi leaves the old copies, so unregister and delete them here.
HIDDEN=(
{{- range (includeTemplate "skills" . | fromJson).hidden }}
    {{ . | quote }}
{{- end }}
)
for name in ${HIDDEN[@]+"${HIDDEN[@]}"}; do
    dir="$HOME/.agents/skills/$name"
    [ -f "$dir/SKILL.md" ] || continue
    agentspec manage remove "$name" >/dev/null 2>&1 || true
    rm -rf "$dir"
    ui_ok "removed $name (its skill pack is not selected)"
done

# Register from the deployed tree, never the chezmoi source: agentspec copies
# files verbatim, so a source path re-introduces chezmoi attribute names
# (executable_check-doc-hygiene.sh) into ~/.agents and chezmoi then flags the
# real file as changed on every apply. chezmoi deploys ~/.agents before this
# run_after script runs.
ui_run "registered dotfiles skills and agents" agentspec manage add "$HOME/.agents" || true

if command -v jq >/dev/null 2>&1; then
    tmp_status="$(mktemp "${TMPDIR:-/tmp}/agentspec-status.XXXXXX")"
    trap 'rm -f "$tmp_status" "$tmp_status.source" "$tmp_status.unmanaged" "$tmp_status.sync"' EXIT

    if ! agentspec --format json status >"$tmp_status" 2>/dev/null; then
        ui_warn "agentspec status failed; skipping the registry sync this time"
        ui_hint "inspect: agentspec status (the next chezmoi apply retries)"
        exit 0
    fi
    hidden_list="${HIDDEN[*]+${HIDDEN[*]}}"
    {
        find "{{ .chezmoi.sourceDir }}/dot_agents/skills" -mindepth 2 -maxdepth 2 -name SKILL.md -print 2>/dev/null |
            sed 's#.*/dot_agents/skills/##; s#/SKILL.md##' |
            awk -v hidden="$hidden_list" 'BEGIN { n = split(hidden, h, " "); for (i = 1; i <= n; i++) skip[h[i]] = 1 }
                !($0 in skip) { print "skill\t" $0 }'
        find "{{ .chezmoi.sourceDir }}/dot_agents/agents" -maxdepth 1 -name '*.md' -print 2>/dev/null |
            sed 's#.*/dot_agents/agents/##; s#.md$##; s#^#agent\t#'
    } | sort >"$tmp_status.source"

    jq -r '.unmanaged[] | select(.found_in | index("shared-store")) | "\(.kind)\t\(.name)"' "$tmp_status" |
        sort >"$tmp_status.unmanaged"

    comm -12 "$tmp_status.source" "$tmp_status.unmanaged" |
        while IFS="$(printf '\t')" read -r _kind name; do
            [ -n "$name" ] || continue
            agentspec manage add "$name" --all-tools >/dev/null 2>&1 && ui_ok "adopted $name" || ui_warn "could not adopt $name"
        done

    cut -f2 "$tmp_status.source" |
        while IFS= read -r name; do
            [ -n "$name" ] || continue
            agentspec manage verify --accept --name "$name" >/dev/null 2>&1 || true
        done

    # A resource adopted without links (older runs adopted without
    # --all-tools) is managed but invisible to every tool. Link it the way the
    # rest are: symlinks, except OpenCode, which gets copies.
    if agentspec --format json status >"$tmp_status" 2>/dev/null; then
        jq -r '.managed[] | select((.links | length) == 0) | .name' "$tmp_status" | sort |
            comm -12 <(cut -f2 "$tmp_status.source" | sort) - |
            while IFS= read -r name; do
                [ -n "$name" ] || continue
                for tool in claude-code github-copilot codex; do
                    agentspec manage link "$name" "$tool" --symlink >/dev/null 2>&1 || true
                done
                agentspec manage link "$name" opencode >/dev/null 2>&1 || true
                ui_ok "linked $name to the AI tools"
            done
    fi

    if agentspec --format json sync --fast >"$tmp_status.sync" 2>/dev/null; then
        read -r managed linked issues < <(jq -r '"\(.managed) \(.links_created + .links_reconciled) \(.integrity_issues)"' "$tmp_status.sync")
        ui_ok "synced: ${managed} managed, ${linked} links updated"
        if [ "${issues:-0}" -gt 0 ]; then
            ui_warn "${issues} integrity issues outside the dotfiles"
            ui_hint "inspect: agentspec status"
        fi
    else
        ui_fail "agentspec sync failed"
        ui_hint "rerun for details: agentspec sync --fast"
    fi
else
    ui_run "synced" agentspec sync --fast || true
fi
