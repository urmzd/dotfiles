#!/usr/bin/env bash
# Chezmoi run_onchange - Install/update Brewfile packages (resilient).
# Runs after the Brewfile target is rendered to $HOME. Continues past individual
# package failures, retries the remainder once, then categorizes what went wrong
# (tap / permission / unknown formula / network / conflict) with next steps, and
# soft-exits so the rest of the dotfiles still apply. brew bundle is idempotent,
# so a later 'chezmoi apply' only reinstalls what is still missing.
# Re-runs whenever the Brewfile, the package selection, or the work pack
# Brewfile (~/.config/work/Brewfile, appended when present) changes.
# Triggered by: {{ include "Brewfile.tmpl" | sha256sum }} exclude={{ .pkg_exclude }}
# Selection: {{ get . "packages" | default list | join "," }} secrets={{ .use_secrets }} work={{ .is_work }}
# Catalog: {{ include "catalog.toml" | sha256sum }}
{{- $work_brewfile := joinPath .chezmoi.homeDir ".config/work/Brewfile" }}
{{- if stat $work_brewfile }}
# Work pack: {{ include $work_brewfile | sha256sum }}
{{- end }}
{{- if .is_macos }}
set -uo pipefail

{{ includeTemplate "ui.sh" . }}
ui_section "Homebrew packages"

if ! command -v brew >/dev/null 2>&1; then
    ui_skip "Homebrew not installed; skipping"
    exit 0
fi

BREWFILE="{{ .chezmoi.homeDir }}/Brewfile"
if [ ! -f "$BREWFILE" ]; then
    ui_skip "no Brewfile at $BREWFILE; nothing to install"
    exit 0
fi

LOG="$(mktemp -t brew-bundle.XXXXXX.log)"
RUN_BREWFILE="$BREWFILE"
TMP_BREWFILE=''
WORK_MERGED=''
cleanup() { rm -f "$LOG" "$TMP_BREWFILE" "$WORK_MERGED"; }
trap cleanup EXIT

# --- work pack Brewfile -----------------------------------------------------
# Appended to the personal Brewfile so excludes, tap trust, and the failure
# report below cover company packages too.
WORK_BREWFILE="{{ $work_brewfile }}"
if [ -f "$WORK_BREWFILE" ]; then
    WORK_MERGED="$(mktemp -t Brewfile-work.XXXXXX)"
    cat "$BREWFILE" "$WORK_BREWFILE" > "$WORK_MERGED"
    RUN_BREWFILE="$WORK_MERGED"
    ui_ok "including work pack Brewfile"
fi

# --- optional exclude filter ("select all, deselect some") -----------------
# Drop any brew/cask/tap line whose quoted target matches an excluded name.
EXCLUDE="{{ .pkg_exclude }}"
if [ -n "${EXCLUDE//[[:space:]]/}" ]; then
    TMP_BREWFILE="$(mktemp -t Brewfile.XXXXXX)"
    awk -v list="$EXCLUDE" '
        BEGIN { n = split(list, a, /[ ,]+/); for (i = 1; i <= n; i++) if (a[i] != "") skip[a[i]] = 1 }
        {
            name = ""
            if (match($0, /"[^"]+"/)) name = substr($0, RSTART + 1, RLENGTH - 2)
            base = name
            sub(/^.*\//, "", base)  # tap-qualified entries (hashicorp/tap/terraform) exclude by basename too
            if (name != "" && ((name in skip) || (base in skip))) next
            print
        }
    ' "$RUN_BREWFILE" > "$TMP_BREWFILE"
    RUN_BREWFILE="$TMP_BREWFILE"
    ui_ok "excluding: ${EXCLUDE}"
fi

# --- trust declared taps ----------------------------------------------------
# Recent Homebrew sets HOMEBREW_REQUIRE_TAP_TRUST and refuses to load formulae
# from untrusted third-party taps. Declaring a tap in the Brewfile is our trust
# statement, so trust each declared tap up front (no-op on older Homebrew).
if brew trust --help >/dev/null 2>&1; then
    awk '/^tap[[:space:]]/ { if (match($0, /"[^"]+"/)) print substr($0, RSTART + 1, RLENGTH - 2) }' "$RUN_BREWFILE" |
        while IFS= read -r tap_name; do
            brew trust --tap "$tap_name" >/dev/null 2>&1 \
                || ui_warn "could not trust tap ${tap_name}; its packages may fail"
        done
fi

# --- one-time migration: terraform moved from homebrew/core (disabled at
# 1.5.7 after the BUSL relicense) to hashicorp/tap. The old keg is still named
# "terraform", so brew bundle would consider hashicorp/tap/terraform satisfied
# and silently keep the frozen 1.5.7. Uninstall it so the tap version installs.
if grep -q '"hashicorp/tap/terraform"' "$RUN_BREWFILE"; then
    tf_receipt="$(brew --prefix)/opt/terraform/INSTALL_RECEIPT.json"
    if [ -f "$tf_receipt" ] && grep -Eq '"tap":[[:space:]]*"homebrew/core"' "$tf_receipt"; then
        ui_step "migrating terraform: homebrew/core (disabled, 1.5.7) -> hashicorp/tap"
        brew uninstall terraform || ui_warn "could not uninstall core terraform; hashicorp/tap/terraform may not link"
    fi
fi

# brew bundle already attempts every entry and installs whatever it can, even
# when some fail; it just exits non-zero afterwards. We capture that and decide.
# Satisfied entries ("Using <pkg>") stay in the log only; the terminal shows
# what is actually being installed or upgraded.
# The index is refreshed once, quietly, up front; bundle's own auto-update
# would otherwise print every new formula and cask in Homebrew.
run_bundle() {
    HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew bundle --file="$RUN_BREWFILE" 2>&1 |
        tee -a "$LOG" | grep -vE '^Using |bundle` complete' | sed 's/^/    /'
    return "${PIPESTATUS[0]}"
}

ui_run "refreshed the Homebrew index" brew update --quiet || true

ui_step "brew bundle (only changes are shown)"
if run_bundle; then
    ui_ok "all Brewfile packages installed"
    exit 0
fi

ui_warn "some packages failed; refreshing Homebrew and retrying the rest"
brew update >/dev/null 2>&1 || true
: > "$LOG"  # keep only the retry output for diagnosis
if run_bundle; then
    ui_ok "all Brewfile packages installed after retry"
    exit 0
fi

# --- still failing: report what broke and how to fix it --------------------
ui_fail "these packages did not install:"

failed_pkgs="$({
    grep -Eo 'Installing [^ ]+ has failed' "$LOG" | awk '{print $2}'
    grep -Eo 'No available (formula|cask)[a-z ]* with the name "[^"]+"' "$LOG" | sed 's/.*"\(.*\)"/\1/'
} | sort -u)"
if [ -n "$failed_pkgs" ]; then
    while IFS= read -r pkg; do ui_fail "$pkg"; done <<< "$failed_pkgs"
fi

matched=0

if grep -qiE 'permission denied|not writable|operation not permitted' "$LOG"; then
    matched=1
    ui_warn "permission issue on the Homebrew prefix"
    ui_hint "sudo chown -R \"\$(whoami)\":admin \"\$(brew --prefix)\"/* && brew doctor"
fi
if grep -qiE 'tapping|could not tap|failure while executing.*tap|repository not found|github api|\b40[13]\b' "$LOG"; then
    matched=1
    ui_warn "tap or GitHub access issue"
    ui_hint "check auth and network: gh auth status (or export HOMEBREW_GITHUB_API_TOKEN)"
    ui_hint "re-tap the failing tap: brew untap <user>/<repo> && brew tap <user>/<repo>"
fi
if grep -qiE 'no available formula|no cask with this name|no formula|could not be found' "$LOG"; then
    matched=1
    ui_warn "unknown formula or cask (stale index or a renamed package)"
    ui_hint "brew update && brew search <name>, then fix the name in Brewfile.tmpl"
fi
if grep -qiE 'could not resolve host|ssl|curl.*(failed|error)|download.*failed|timed out' "$LOG"; then
    matched=1
    ui_warn "network or download issue"
    ui_hint "once the connection is stable: brew bundle --file=\"$BREWFILE\""
fi
if grep -qiE 'already an app at|it conflicts with|already exists' "$LOG"; then
    matched=1
    ui_warn "a cask conflicts with an app already on disk"
    ui_hint "adopt the existing install: brew bundle --file=\"$BREWFILE\" --force"
    ui_hint "or remove the old app first, then rerun brew bundle"
fi
if [ "$matched" -eq 0 ]; then
    ui_hint "review the output above, then rerun: brew bundle --file=\"$BREWFILE\""
fi

ui_warn "continuing so the rest of your dotfiles still apply"
ui_hint "after fixing, rerun chezmoi apply; brew bundle only installs what is missing"
exit 0
{{- end }}
