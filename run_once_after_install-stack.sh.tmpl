#!/usr/bin/env bash
{{ includeTemplate "bash-modern.sh" . }}
# Install urmzd/* stack CLIs (sr, teasr, oag, dotfiles) via their upstream installers.
set -euo pipefail
{{ includeTemplate "ui.sh" . }}
ui_section "Stack CLIs"

install_if_missing() {
    local name="$1"
    local url="$2"

    if command -v "$name" &>/dev/null; then
        ui_skip "$name already installed"
        return 0
    fi
    ui_run "installed $name" fetch_and_run "$url" sh || ui_hint "retry: chezmoi apply (installer: $url)"
}

install_if_missing sr    https://raw.githubusercontent.com/urmzd/sr/main/install.sh
install_if_missing teasr https://raw.githubusercontent.com/urmzd/teasr/main/install.sh
install_if_missing oag   https://raw.githubusercontent.com/urmzd/oag/main/install.sh
# The dotfiles CLI lives in this repo (cli/); its binaries ship on dotfiles releases.
DOTFILES_CLI_INSTALL=https://raw.githubusercontent.com/urmzd/dotfiles/main/cli/install.sh
# One-time migration: 0.1.x binaries came from the retired urmzd/dotfiles-cli
# repo and their self-update points there, so replace them.
if command -v dotfiles >/dev/null 2>&1 && dotfiles version 2>/dev/null | grep -q '^dotfiles v0\.1\.'; then
    ui_run "reinstalled dotfiles from urmzd/dotfiles releases" fetch_and_run "$DOTFILES_CLI_INSTALL" sh \
        || ui_hint "retry: chezmoi apply (installer: $DOTFILES_CLI_INSTALL)"
fi
install_if_missing dotfiles "$DOTFILES_CLI_INSTALL"
