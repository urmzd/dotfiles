#!/usr/bin/env bash
{{ includeTemplate "bash-modern.sh" . }}
# chezmoi modify_ script for ~/.gemini/antigravity-cli/settings.json (agy).
# agy writes here itself (auth, gcp project, trustedWorkspaces, /config), so
# merge instead of overwriting: live values win, the managed baseline only
# fills missing keys. Baseline: auto mode with the terminal sandbox, which
# auto mode requires. agy falls back to default mode where auto is unavailable
# (business/GCP auth, unsupported hosts).
set -euo pipefail

current="$(cat)"
managed='{"agentMode":"auto","enableTerminalSandbox":true}'

# First bootstrap: jq arrives via the Brewfile, after files apply. Seed an
# empty target with the baseline; never touch a non-empty one without jq.
if ! command -v jq >/dev/null 2>&1; then
    if [ -z "${current//[[:space:]]/}" ]; then
        printf '%s\n' "$managed"
    else
        printf '%s' "$current"
    fi
    exit 0
fi

if [ -z "${current//[[:space:]]/}" ]; then
    current='{}'
fi

# A live file agy can't parse is already broken; leave it as-is.
if ! jq -e . >/dev/null 2>&1 <<<"$current"; then
    echo "modify_settings.json: live ~/.gemini/antigravity-cli/settings.json is not valid JSON; leaving it untouched" >&2
    printf '%s' "$current"
    exit 0
fi

jq -n --argjson managed "$managed" --argjson current "$current" '$managed * $current'
