#!/usr/bin/env zsh
# ~/.zshenv: Always sourced, sets up environment variables

# XDG Base Directory Specification
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

# Editor configuration
export EDITOR='nvim'
export VISUAL='nvim'

# Ensure local bin is in PATH
if [ -d "$HOME/.local/bin" ]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

# Default Python (uv-managed, see run_onchange_before_install-python): first on
# PATH so python/python3 never fall back to macOS's 3.9; ~/.zprofile repeats
# this after Homebrew. gcloud reads CLOUDSDK_PYTHON instead of PATH.
if [ -x "$HOME/.local/share/dotfiles/python/bin/python3" ]; then
    export PATH="$HOME/.local/share/dotfiles/python/bin:$PATH"
    export CLOUDSDK_PYTHON="$HOME/.local/share/dotfiles/python/bin/python3"
fi

# OpenCode native installer
if [ -d "$HOME/.opencode/bin" ]; then
    export PATH="$HOME/.opencode/bin:$PATH"
fi

# Rust toolchain (rustup)
if [ -d "$HOME/.cargo/bin" ]; then
    export PATH="$HOME/.cargo/bin:$PATH"
fi

# Google Cloud CLI (installed by run_onchange_after_install-cloud-clis.sh)
if [ -f "$HOME/.local/share/google-cloud-sdk/path.zsh.inc" ]; then
    . "$HOME/.local/share/google-cloud-sdk/path.zsh.inc"
fi

# Work pack env (proxies, registries, PATH). Sourced here rather than in
# .zshrc so non-interactive shells, including agent tool calls, see it too.
if [ -r {{ printf "%s/env.zsh" (includeTemplate "work-pack-dir" .) | quote }} ]; then
    . {{ printf "%s/env.zsh" (includeTemplate "work-pack-dir" .) | quote }}
fi
