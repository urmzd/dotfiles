#!/usr/bin/env bash
# Load Docker cleanup launchd agent
{{- if .is_macos }}
{{ includeTemplate "ui.sh" . }}
ui_section "Docker cleanup"

PLIST_PATH="$HOME/Library/LaunchAgents/com.docker.cleanup.plist"

# Unload if already loaded (ignore errors)
launchctl unload "$PLIST_PATH" 2>/dev/null || true

if launchctl load "$PLIST_PATH" 2>/dev/null; then
    ui_ok "launchd agent loaded (daily at 3 AM)"
else
    ui_fail "could not load $PLIST_PATH"
    ui_hint "check it: launchctl load -w $PLIST_PATH"
    exit 1
fi
{{- end }}
